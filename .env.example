# BidSure Environment Configuration

PORT=5000
NODE_ENV=development

# PostgreSQL Connection (Optional: if omitted, BidSure uses the local persistent store)
# DATABASE_URL=postgresql://username:password@localhost:5432/bidsure

# Google Gemini API Key (Optional: if omitted, BidSure uses the deterministic heuristic extraction engine)
# GEMINI_API_KEY=your_gemini_api_key_here

